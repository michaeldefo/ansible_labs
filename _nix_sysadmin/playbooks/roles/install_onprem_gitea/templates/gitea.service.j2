[Unit]
Description=Gitea (Git with a cup of tea)
After=syslog.target
After=network.target
Wants=network.target

[Service]
RestartSec=2s
Type=simple
User={{ gitea_user }}
Group={{ gitea_user }}
Environment=APP_DATA_PATH={{ gitea_home }}
WorkingDirectory={{ gitea_home }}
ExecStart={{ gitea_bin }} web --config {{ gitea_config }}/app.ini
Restart=always
Environment=USER={{ gitea_user}} HOME={{ gitea_home}}

[Install]
WantedBy=multi-user.target
